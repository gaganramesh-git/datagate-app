{
  "name": "DataGate",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": { "cpus": 2 },
  "containerEnv": { "UV_LINK_MODE": "copy" },
  "postCreateCommand": "python -m pip install --user --quiet uv && python -m uv sync --extra service",
  "postAttachCommand": ".venv/bin/datagate serve --host 0.0.0.0 --port 8000",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "DataGate", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.terminal.activateEnvironment": false,
        "python-envs.terminal.autoActivationType": "off"
      }
    }
  }
}
